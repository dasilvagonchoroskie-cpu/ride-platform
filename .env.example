# ============================================================
# ride-platform - variaveis de ambiente
# Copie para .env na raiz e ajuste conforme o ambiente.
# ============================================================

# ---------- Aplicacao ----------
NODE_ENV=development
BACKEND_PORT=3333
BACKEND_HOST=0.0.0.0
API_PREFIX=api
API_URL=http://localhost:3333
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,exp://127.0.0.1:8081

# ---------- Banco de dados (PostgreSQL + PostGIS) ----------
POSTGRES_USER=ride
POSTGRES_PASSWORD=ride
POSTGRES_DB=ride
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ride:ride@localhost:5432/ride?schema=public&connection_limit=10

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- Autenticacao ----------
# Gere com: openssl rand -hex 48
JWT_ACCESS_SECRET=troque-este-segredo-por-um-valor-aleatorio-de-48-bytes
JWT_ACCESS_TTL=900
JWT_REFRESH_SECRET=troque-este-outro-segredo-por-um-valor-aleatorio-de-48-bytes
JWT_REFRESH_TTL=2592000
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
# Em desenvolvimento o OTP e impresso no log da API
OTP_DEBUG_RETURN=true

# ---------- Armazenamento de arquivos (S3 / MinIO / Cloudflare R2) ----------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=ride
S3_SECRET_KEY=ride12345
S3_BUCKET_DOCUMENTS=ride-documents
S3_BUCKET_PUBLIC=ride-public
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_TTL=900
S3_PUBLIC_URL=http://localhost:9000

# ---------- Notificacoes ----------
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Ride <no-reply@ride.local>"
SMS_PROVIDER=console

# ---------- Google Maps Platform ----------
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_CACHE_TTL=300

# ---------- Pagamentos ----------
PAYMENT_PROVIDER=asaas
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------- Regras de negocio ----------
DEFAULT_COMMISSION_PERCENT=20
MIN_PAYOUT_CENTS=5000

<?xml version="1.0" encoding="utf-8"?>
<!-- Auditoria de 06/11/2026: nada do aplicativo (login, token, dados da
     conta) vai para o backup na nuvem nem passa para outro celular na
     troca de aparelho. A pessoa entra de novo com o codigo. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>

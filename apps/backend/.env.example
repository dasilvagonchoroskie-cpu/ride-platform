# Copie para .env (o ConfigModule tambem le o .env da raiz do monorepo).
NODE_ENV=development
BACKEND_PORT=3333
BACKEND_HOST=0.0.0.0
API_PREFIX=api
API_URL=http://localhost:3333
CORS_ORIGINS=*

DATABASE_URL=postgresql://ride:ride@localhost:5432/ride?schema=public&connection_limit=10

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

JWT_ACCESS_SECRET=troque-este-segredo-por-um-valor-aleatorio-de-48-bytes
JWT_ACCESS_TTL=900
JWT_REFRESH_SECRET=troque-este-outro-segredo-por-um-valor-aleatorio-de-48-bytes
JWT_REFRESH_TTL=2592000

OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_DEBUG_RETURN=true

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=ride
S3_SECRET_KEY=ride12345
S3_BUCKET_DOCUMENTS=ride-documents
S3_BUCKET_PUBLIC=ride-public
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_TTL=900
S3_PUBLIC_URL=http://localhost:9000

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="Ride <no-reply@ride.local>"

GOOGLE_MAPS_API_KEY=

PAYMENT_PROVIDER=asaas
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
ASAAS_API_KEY=

DEFAULT_COMMISSION_PERCENT=20
MIN_PAYOUT_CENTS=5000

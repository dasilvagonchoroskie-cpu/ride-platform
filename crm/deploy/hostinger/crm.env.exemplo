# CRM Fortaleza Move — variáveis de ambiente para a VPS da Hostinger (MODELO, SEM SEGREDOS).
# Na VPS este arquivo vira /etc/fortaleza-crm/crm.env (dono root, grupo fortaleza-crm, permissão 640).
# NUNCA coloque o arquivo preenchido no GitHub, em e-mail ou em conversa. Cópia de segurança dele: só no cofre de senhas.
# Linhas começando com # são comentários.

# ---------------------------------------------------------------- servidor
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
# O Nginx fica na mesma máquina: só ele é confiável para dizer o IP de quem acessa.
TRUST_PROXY=loopback
COOKIE_SECURE=true
# Endereço público definitivo (usado nos links de e-mail). Ex.: https://crm.seudominio.com.br
PUBLIC_URL=
# Pasta dos dados (banco, sessão do WhatsApp, chaves da IA). Disco PERSISTENTE da VPS.
FM_DATA_DIR=/var/lib/fortaleza-crm
WA_LIB_DIR=/opt/fortaleza-crm/wa-lib
# Etapa 2 (pessoas, entregadores, comércios, documentos, candidatos). Só ligar depois da autorização do dono.
FM_ETAPA2=

# ---------------------------------------------------------------- chaves (64 caracteres hexadecimais cada)
# Copiar do Render (NÃO gerar novas): SNAPSHOT_* — sem elas os dados atuais não são trazidos.
SNAPSHOT_URL=
SNAPSHOT_ANON=
SNAPSHOT_TOKEN=
SNAPSHOT_KEY=
# Na VPS o disco é persistente: o cofre vira só CÓPIA cifrada fora do servidor (ver README, passo 5).
SNAPSHOT_MODO=copia
# Geradas UMA vez na VPS no dia da migração (scripts/gerar-chaves.sh) e guardadas no cofre de senhas do dono.
# Perder FM_DOCS_KEY = perder os documentos. Trocar por engano = o CRM bloqueia novos envios com aviso.
FM_DOCS_KEY=
FM_DADOS_KEY=
# Documentos guardados no disco da VPS (cifrados, AES-256-GCM, nunca públicos).
DOCS_STORAGE=local
DOCS_DIR=/var/lib/fortaleza-crm/documentos
FM_DOCS_LOCAL_PERSISTENTE=1
DOCS_MAX_MB=10

# ---------------------------------------------------------------- e-mail (recuperação de senha e código de aparelho novo)
RESEND_API_KEY=
# ou: BREVO_API_KEY= e EMAIL_FROM=

# ---------------------------------------------------------------- IA (Gemini). A chave fica cadastrada pela tela; aqui só se preferir.
# GEMINI_API_KEY=
# Quando contratar a API paga do Gemini: só trocar a chave em Configurações > Inteligência (IA) e escolher o modelo. Nada muda no código.

# ---------------------------------------------------------------- aplicativo Android (Trusted Web Activity)
# O app abre o CRM pelo endereço novo: gerar APK com o domínio novo e publicar a impressão digital aqui.
TWA_PACOTE=
TWA_SHA256=
